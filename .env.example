# PharmaTrack environment template (copy to .env for docker-compose).
# Local dev defaults match application.yml and docker-compose.yml.

# --- Database ---
POSTGRES_DB=pharmatrack
POSTGRES_USER=pharmatrack
POSTGRES_PASSWORD=pharmatrack

# --- Backend ---
# DB_URL overrides where the backend connects (compose uses host 'db').
DB_URL=jdbc:postgresql://localhost:5432/pharmatrack
DB_USERNAME=pharmatrack
DB_PASSWORD=pharmatrack
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
# 64+ byte base64 secret for HS256 JWT signing (Epic 1). DO NOT reuse in prod.
JWT_SECRET=U2VjdXJlLURldi9Qcm9kLUtleS1DaGFuZ2UtTWUtNjQrQnl0ZXMtU3VwZXItTG9uZy1Gb3ItSFMyNTZBLUhlYWx0aC1GdW5jdGlvbg==
